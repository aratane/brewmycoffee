# ─── DATABASE ────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/artisan_brew?schema=public"

# ─── AUTH ─────────────────────────────────────────────────────────────────
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST=true

# ─── APP ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── PAYMENT: MIDTRANS ────────────────────────────────────────────────────
# PAYMENT_MODE = sandbox | live | disabled
PAYMENT_MODE="disabled"
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"
# Must match the value set in Midtrans dashboard -> Settings -> Webhooks
MIDTRANS_WEBHOOK_SECRET=""

# ─── SUPABASE (optional: storage + realtime) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ─── STORAGE ───────────────────────────────────────────────────────────────
# local (filesystem) or supabase
STORAGE_DRIVER="local"
