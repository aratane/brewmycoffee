generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────

enum RoleName {
  SUPER_ADMIN
  ADMIN
  CASHIER
  BARISTA
  CUSTOMER
}

enum OrderSource {
  ONLINE
  POS
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  QRIS
  BANK_TRANSFER
  CASH
  CARD
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
  VERIFIED
  REJECTED
}

enum TransactionStatus {
  PENDING
  COMPLETED
  REFUNDED
  VOID
}

enum MovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  WASTE
  RETURN
}

enum ProductSize {
  SMALL
  MEDIUM
  LARGE
}

enum Temperature {
  HOT
  ICED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
}

enum VoucherType {
  PERCENT
  FIXED
}

// ─── IDENTITY ─────────────────────────────────────────────────────────────

model Role {
  id        String   @id @default(cuid())
  name      RoleName @unique
  label     String
  createdAt DateTime @default(now())
  users     User[]
  @@map("roles")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  avatarUrl    String?
  emailVerified DateTime?
  isActive     Boolean   @default(true)
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  customer     Customer?
  employee     Employee?
  orders       Order[]
  auditLogs    AuditLog[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  @@index([roleId])
  @@map("users")
}

model Employee {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  position   String
  branch     String   @default("Main")
  cashierCode String  @unique
  isActive   Boolean  @default(true)
  hireDate   DateTime @default(now())
  transactions Transaction[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@map("employees")
}

model Customer {
  id        String   @id @default(cuid())
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  email     String?
  phone     String?
  avatarUrl String?
  notes     String?
  orders    Order[]
  loyalty   LoyaltyPoint?
  reviews   Review[]
  wishlist  WishlistItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([phone])
  @@map("customers")
}

// ─── CATALOG ──────────────────────────────────────────────────────────────

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  icon        String?
  imageUrl    String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@map("categories")
}

model Product {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  description     String
  longDescription String?
  price           Decimal          @db.Decimal(12, 2)
  imageUrl        String?
  gradient        String           @default("from-caramel to-mocha")
  categoryId      String
  category        Category         @relation(fields: [categoryId], references: [id])
  sku             String           @unique
  barcode         String?          @unique
  isAvailable     Boolean          @default(true)
  isFeatured      Boolean          @default(false)
  preparationTime Int              @default(5)
  calories        Int?
  sortOrder       Int              @default(0)
  rating          Float            @default(0)
  soldCount       Int              @default(0)
  variants        ProductVariant[]
  addons          ProductAddon[]
  recipes         Recipe[]
  orderItems      OrderItem[]
  reviews         Review[]
  wishlist        WishlistItem[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  @@index([categoryId])
  @@index([isFeatured])
  @@map("products")
}

model ProductVariant {
  id            String      @id @default(cuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String
  size          ProductSize?
  temperature   Temperature?
  priceAdjustment Decimal   @default(0) @db.Decimal(12, 2)
  sku           String?     @unique
  isAvailable   Boolean     @default(true)
  createdAt     DateTime    @default(now())
  @@unique([productId, name])
  @@map("product_variants")
}

model ProductAddon {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String
  price       Decimal  @db.Decimal(12, 2)
  sku         String?
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  @@unique([productId, name])
  @@map("product_addons")
}

// ─── INVENTORY ────────────────────────────────────────────────────────────

model Ingredient {
  id         String             @id @default(cuid())
  name       String             @unique
  unit       String             @default("g")
  sku        String?            @unique
  costPerUnit Decimal            @default(0) @db.Decimal(12, 2)
  supplier   String?
  isActive   Boolean            @default(true)
  inventory  Inventory?
  recipes    Recipe[]
  movements  InventoryMovement[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  @@map("ingredients")
}

model Inventory {
  id            String      @id @default(cuid())
  ingredientId  String      @unique
  ingredient    Ingredient  @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  quantity      Decimal     @default(0) @db.Decimal(12, 3)
  minimumLevel  Decimal     @default(0) @db.Decimal(12, 3)
  unitCost      Decimal     @default(0) @db.Decimal(12, 2)
  lastRestocked DateTime?
  movements     InventoryMovement[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  @@map("inventory")
}

model InventoryMovement {
  id            String        @id @default(cuid())
  inventoryId   String
  inventory     Inventory     @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  ingredientId  String
  ingredient    Ingredient    @relation(fields: [ingredientId], references: [id])
  type          MovementType
  quantity      Decimal       @db.Decimal(12, 3)
  previousQty   Decimal       @db.Decimal(12, 3)
  newQty        Decimal       @db.Decimal(12, 3)
  referenceType String?
  referenceId   String?
  note          String?
  createdBy     String?
  createdAt     DateTime      @default(now())
  @@index([inventoryId, createdAt])
  @@index([referenceType, referenceId])
  @@map("inventory_movements")
}

model Recipe {
  id           String     @id @default(cuid())
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  quantity     Decimal    @db.Decimal(12, 3)
  unit         String     @default("g")
  @@unique([productId, ingredientId])
  @@map("recipes")
}

// ─── ORDERS & PAYMENTS ────────────────────────────────────────────────────

model Table {
  id       String      @id @default(cuid())
  number   String      @unique
  seats    Int         @default(2)
  status   TableStatus @default(AVAILABLE)
  qrToken  String?     @unique
  orders   Order[]
  createdAt DateTime   @default(now())
  @@map("tables")
}

model Order {
  id           String        @id @default(cuid())
  orderNumber  String        @unique
  source       OrderSource   @default(ONLINE)
  type         OrderType     @default(TAKEAWAY)
  status       OrderStatus   @default(PENDING_PAYMENT)
  customerId   String?
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  userId       String?
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  tableId      String?
  table        Table?        @relation(fields: [tableId], references: [id], onDelete: SetNull)
  customerName  String
  customerPhone String?
  customerEmail String?
  notes        String?
  subtotal     Decimal       @db.Decimal(12, 2)
  discount     Decimal       @default(0) @db.Decimal(12, 2)
  tax          Decimal       @default(0) @db.Decimal(12, 2)
  serviceCharge Decimal      @default(0) @db.Decimal(12, 2)
  deliveryFee  Decimal       @default(0) @db.Decimal(12, 2)
  total        Decimal       @db.Decimal(12, 2)
  voucherCode  String?
  loyaltyUsed  Int           @default(0)
  loyaltyEarned Int          @default(0)
  items        OrderItem[]
  payments     Payment[]
  transaction  Transaction?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  @@index([status, createdAt])
  @@index([customerId])
  @@index([source, createdAt])
  @@map("orders")
}

model OrderItem {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId   String?
  nameSnapshot String
  unitPrice   Decimal      @db.Decimal(12, 2)
  quantity    Int          @default(1)
  size        ProductSize?
  temperature Temperature?
  sugarLevel  Int          @default(100)
  iceLevel    Int          @default(100)
  extraShot   Boolean      @default(false)
  extraMilk   Boolean      @default(false)
  addons      Json         @default("[]")
  note        String?
  lineTotal   Decimal      @db.Decimal(12, 2)
  createdAt   DateTime     @default(now())
  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id                  String        @id @default(cuid())
  orderId             String
  order               Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method              PaymentMethod
  status              PaymentStatus @default(PENDING)
  amount              Decimal       @db.Decimal(12, 2)
  gateway             String?
  gatewayOrderId      String?       @unique
  gatewayTransactionId String?
  qrisString          String?
  vaNumber            String?
  bank                String?
  expirationAt        DateTime?
  paidAt              DateTime?
  proofUrl            String?
  verifiedById        String?
  verifiedAt          DateTime?
  rejectionReason     String?
  metadata            Json          @default("{}")
  webhooks            PaymentWebhook[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  @@index([orderId])
  @@index([status])
  @@map("payments")
}

model PaymentWebhook {
  id            String   @id @default(cuid())
  paymentId     String?
  payment       Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  gateway       String
  eventId       String   @unique
  eventType     String?
  payload       Json
  signatureValid Boolean  @default(false)
  processedAt   DateTime?
  createdAt     DateTime @default(now())
  @@map("payment_webhooks")
}

model Transaction {
  id                 String            @id @default(cuid())
  transactionNumber  String            @unique
  orderId            String?           @unique
  order              Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  cashierId          String?
  cashier            Employee?         @relation(fields: [cashierId], references: [id], onDelete: SetNull)
  type               OrderSource       @default(POS)
  subtotal           Decimal           @db.Decimal(12, 2)
  discount           Decimal           @default(0) @db.Decimal(12, 2)
  tax                Decimal           @default(0) @db.Decimal(12, 2)
  serviceCharge      Decimal           @default(0) @db.Decimal(12, 2)
  total              Decimal           @db.Decimal(12, 2)
  amountTendered     Decimal?          @db.Decimal(12, 2)
  change             Decimal?          @db.Decimal(12, 2)
  paymentMethod      PaymentMethod
  paymentStatus      PaymentStatus     @default(PENDING)
  status             TransactionStatus @default(COMPLETED)
  receiptData        Json?
  createdAt          DateTime          @default(now())
  @@index([createdAt])
  @@index([cashierId])
  @@map("transactions")
}

// ─── CUSTOMER ENGAGEMENT ──────────────────────────────────────────────────

model Voucher {
  id          String      @id @default(cuid())
  code        String      @unique
  type        VoucherType
  value       Decimal     @db.Decimal(12, 2)
  minOrder    Decimal     @default(0) @db.Decimal(12, 2)
  maxDiscount Decimal?    @db.Decimal(12, 2)
  usageLimit  Int?
  usedCount   Int         @default(0)
  expiresAt   DateTime?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  @@map("vouchers")
}

model LoyaltyPoint {
  id            String   @id @default(cuid())
  customerId    String   @unique
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  points        Int      @default(0)
  lifetimePoints Int     @default(0)
  tier          String   @default("Bean")
  updatedAt     DateTime @updatedAt
  @@map("loyalty_points")
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  rating     Int
  comment    String?
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  @@index([productId, isApproved])
  @@map("reviews")
}

// ─── SYSTEM ──────────────────────────────────────────────────────────────

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  @@map("newsletter_subscribers")
}

model WishlistItem {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  @@unique([customerId, productId])
  @@map("wishlist_items")
}

model StoreSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
  @@map("store_settings")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entity     String
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
